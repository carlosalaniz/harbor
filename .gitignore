# dependencies / build (root-only; bare names would also ignore src/state/, src/*/dist/, etc.)
/node_modules/
/dist/
/web/dist/
/release/
/coverage/
*.tsbuildinfo

# local state, secrets, logs (never committed; root-only for the same reason)
/.env*
!.env.example
/.vm.local.json
/.vm-known_hosts
*.log
/.harbor-dev/
/state/
/tmp/
/test-results/
/playwright-report/
/.vagrant/
/evidence/raw/

# editors / OS
.DS_Store
.idea/
.vscode/
.vm*.local.json
.vm*-known_hosts

# Live VM runs land here on every `pnpm test:vm`; most are iteration scratch. Only runs cited in
# docs/VERIFICATION.md are kept: add those with `git add -f docs/evidence/vm-<ts>` (tracked runs stay tracked).
/docs/evidence/vm-*/
