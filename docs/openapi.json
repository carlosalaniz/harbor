{
  "openapi": "3.1.0",
  "info": {
    "title": "Harbor local API",
    "version": "0.0.0-doc",
    "description": "Loopback-only administration API for the Harbor local preview. Bearer sessions; JSON only."
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "description": "Daemon liveness only.",
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "description": "Log in the local administrator. Rate limited.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "security": [],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "token",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "nextAction": {
                          "type": "string"
                        },
                        "operationId": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "nextAction"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "nextAction": {
                          "type": "string"
                        },
                        "operationId": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "nextAction"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/current": {
      "delete": {
        "description": "Revoke the current session.",
        "responses": {
          "204": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/system": {
      "get": {
        "description": "Daemon/Docker availability.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/catalog": {
      "get": {
        "description": "Bundled packages.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/catalog/{id}/asset/{name}": {
      "get": {
        "description": "Package presentation asset (icon/gallery) from the bundled package. Open (no session): static catalog content only.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}\\.(svg|png|jpg|jpeg|webp)$"
            },
            "in": "path",
            "name": "name",
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/system/metrics": {
      "get": {
        "description": "Host metrics for the console (cpu, memory, disk, docker).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/instances": {
      "get": {
        "description": "All instances including retained records.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/instances/{id}": {
      "get": {
        "description": "Instance detail with safe events, resource roles and setup guidance.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/plans/{id}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-7][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/operations/{id}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-7][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/platform-tools": {
      "get": {
        "description": "Cockpit/Portainer/Tailscale/proxy state and real links.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/exposures": {
      "get": {
        "description": "Published addresses (tailnet/public) of all instances.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/account/password": {
      "put": {
        "description": "Change the administrator password (current password required); every other session is revoked.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/host/storage": {
      "get": {
        "description": "Disks (mounts), the Harbor data folder and folders in use by apps.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/host/folders": {
      "get": {
        "description": "Subfolders of a host folder (system locations hidden).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "in": "query",
            "name": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "description": "Create one new folder inside a parent the Harbor service account may write to.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "parent",
                  "name"
                ],
                "properties": {
                  "parent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/domains": {
      "get": {
        "description": "Registered public domains with DNS check results, this machine's public address and which app uses each domain.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "description": "Register a domain you own and check that its DNS points at this machine.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hostname"
                ],
                "properties": {
                  "hostname": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 253
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/domains/{hostname}/check": {
      "post": {
        "description": "Re-check a registered domain's DNS.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
              "maxLength": 253
            },
            "in": "path",
            "name": "hostname",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/domains/{hostname}": {
      "delete": {
        "description": "Forget a registered domain (refused while an app is published at it).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
              "maxLength": 253
            },
            "in": "path",
            "name": "hostname",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/appearance": {
      "get": {
        "description": "Wallpaper state (uploaded/rotating with attribution), rotation settings (no secrets) and the launcher order.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/appearance/wallpaper": {
      "get": {
        "description": "The current wallpaper picture (open: background art loaded by <img>/CSS, which cannot send a token).",
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "put": {
        "description": "Set your own wallpaper: a PNG, JPEG or WebP picture as a data URL (max 6 MB).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dataUrl"
                ],
                "properties": {
                  "dataUrl": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 8388608
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "delete": {
        "description": "Remove your uploaded wallpaper picture.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/appearance/rotation": {
      "put": {
        "description": "Rotating wallpapers: turn on/off, choose the source (reddit needs your own Reddit app credentials; bing and wikimedia need none), subreddits and how often. Fetches the first picture right away when turning on.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "source": {
                    "enum": [
                      "reddit",
                      "bing",
                      "wikimedia"
                    ]
                  },
                  "subreddits": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    }
                  },
                  "everyHours": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 720
                  },
                  "reddit": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "clientId"
                        ],
                        "properties": {
                          "clientId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "clientSecret": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/appearance/rotation/next": {
      "post": {
        "description": "Skip to the next rotating wallpaper now.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/appearance/home": {
      "put": {
        "description": "Launcher order (instance ids, first to last). Unknown ids are dropped; missing ones keep their default position.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "order"
                ],
                "properties": {
                  "order": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-7][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/instances/{id}/appearance": {
      "put": {
        "description": "Customise how an app appears on the launcher: display name and icon (default, an emoji/letters on a colour, or an uploaded picture up to 1 MB).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 80
                  },
                  "icon": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "enum": [
                              "default"
                            ]
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "glyph",
                          "color"
                        ],
                        "properties": {
                          "kind": {
                            "enum": [
                              "glyph"
                            ]
                          },
                          "glyph": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 16
                          },
                          "color": {
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "dataUrl"
                        ],
                        "properties": {
                          "kind": {
                            "enum": [
                              "image"
                            ]
                          },
                          "dataUrl": {
                            "type": "string",
                            "minLength": 32,
                            "maxLength": 1536000
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-7][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/instances/{id}/icon": {
      "get": {
        "description": "Custom launcher icon picture of an app (open: loaded by <img>).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-7][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/packages": {
      "post": {
        "description": "Upload a package zip. Harbor validates it like a bundled package, pins tag images by digest at the registry and writes release.json. A higher revision of an already uploaded id becomes an update for its instances.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fileName",
                  "dataUrl"
                ],
                "properties": {
                  "fileName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "dataUrl": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 73400320
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/packages/{id}": {
      "delete": {
        "description": "Remove an uploaded package (refused while an app installed from it exists).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/system/host": {
      "get": {
        "description": "Hostname, OS, CPU and whether Harbor may restart or shut down this machine.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/system/power": {
      "post": {
        "description": "Restart or shut down the machine (apps come back on their own after a restart).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "reboot",
                      "poweroff"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/platform-tools/tailscale/login": {
      "post": {
        "description": "Log this host into a tailnet: with an auth key, or get a login URL to approve in a browser.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "authKey": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 512
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/platform-tools/tailscale/logout": {
      "post": {
        "description": "Log this host out of the tailnet (withdraws tailnet addresses).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/ui-exposure": {
      "put": {
        "description": "Expose the Harbor UI on the tailnet (never publicly).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "via"
                ],
                "properties": {
                  "via": {
                    "enum": [
                      "tailnet"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "delete": {
        "description": "Withdraw the tailnet exposure of the Harbor UI.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/platform-tools/{id}": {
      "put": {
        "description": "Bind an already installed tool by its loopback URL without taking ownership.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "browserUrl"
                ],
                "properties": {
                  "browserUrl": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "enum": [
                "cockpit",
                "portainer"
              ]
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
